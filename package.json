{
  "name": "react-appear-in-workspace",
  "private": true,
  "description": "Make React components render sometime in the future",
  "scripts": {
    "build": "pnpm --filter react-appear-in build",
    "demo": "pnpm --filter @react-appear-in/demo dev",
    "demo:build": "pnpm --filter @react-appear-in/demo build",
    "test": "pnpm --filter @react-appear-in/test test",
    "format": "prettier --write './{apps,packages}/**/*.{ts,tsx,html,json,css}' './*.{json,md,yaml,yml}'"
  },
  "engines": {
    "node": "24",
    "pnpm": "11"
  },
  "devDependencies": {
    "prettier": "catalog:"
  }
}
